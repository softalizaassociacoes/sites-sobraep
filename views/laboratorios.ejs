<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('partials/head', { title: 'Laboratórios e Grupos de Pesquisa', description: 'Mapa dos laboratórios e grupos de pesquisa em Eletrônica de Potência associados à SOBRAEP, distribuídos pelo Brasil.' }) %>
</head>
<body>
<%- include('partials/header') %>

<%
  // Estados que têm laboratório: só eles ficam clicáveis no mapa.
  const porUf = {};
  laboratorios.forEach(function (l) {
    // o grupo aparece em todos os estados onde tem polo
    var ufs = (l.polos && l.polos.length)
      ? l.polos.map(function (p) { return p.uf; })
      : [l.uf];
    ufs.filter(Boolean).forEach(function (uf) {
      porUf[uf] = porUf[uf] || [];
      if (porUf[uf].indexOf(l) === -1) porUf[uf].push(l);
    });
  });
  const ufsComLab = Object.keys(porUf).sort();
  const semLocal = laboratorios.filter(function (l) { return l.left === null || l.left === undefined; });
  const totalMembros = laboratorios.reduce(function (s, l) { return s + (l.integrantes || 0); }, 0);
%>

<main id="conteudo">
  <section class="page-hero">
    <div class="container">
      <h1>Laboratórios e Grupos de Pesquisa</h1>
      <p>Uma rede nacional de excelência em Eletrônica de Potência, acionamentos e suas aplicações.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="labs-numeros">
        <div><strong><%= laboratorios.length %></strong><span>Grupos de pesquisa</span></div>
        <div><strong><%= totalInstituicoes %></strong><span>Instituições</span></div>
        <div><strong><%= ufsComLab.length %></strong><span>Estados</span></div>
        <div><strong><%= totalMembros %>+</strong><span>Integrantes</span></div>
      </div>

      <p class="labs-intro">
        Clique em um estado do mapa para ver os grupos daquela região, ou percorra a
        lista ao lado — ao passar por um item, uma linha mostra onde ele fica no mapa.
      </p>

      <div class="labs-painel">
        <!-- Mapa -->
        <div class="labs-mapa-col">
          <div class="labs-mapa" id="labsMapa">
            <div class="labs-zoom" role="group" aria-label="Zoom do mapa">
              <button type="button" id="labsZoomMais" aria-label="Aproximar">+</button>
              <button type="button" id="labsZoomMenos" aria-label="Afastar">&minus;</button>
              <button type="button" id="labsZoomReset" aria-label="Voltar ao tamanho normal">⟲</button>
              <span class="labs-zoom-nivel" id="labsZoomNivel">100%</span>
            </div>

            <div class="labs-palco" id="labsPalco">
              <div class="labs-mapa-base"><%- mapaSvg %></div>

            <% laboratorios.forEach(function (l, i) {
                 // um grupo pode ter polos em cidades diferentes: cada um vira
                 // um marcador, mas todos apontam para o mesmo laboratório
                 var pontos = (l.polos && l.polos.length)
                   ? l.polos
                   : (l.left === null ? [] : [{ cidade: l.cidade, uf: l.uf, left: l.left, top: l.top }]);
                 pontos.forEach(function (p) { %>
            <button type="button" class="labs-ponto<%= (l.polos && l.polos.length > 1) ? ' labs-ponto--polo' : '' %>"
                    style="left: <%= p.left %>%; top: <%= p.top %>%;"
                    data-lab="<%= i %>" data-uf="<%= p.uf %>"
                    aria-label="<%= l.sigla %> — <%= p.cidade %>/<%= p.uf %><%= (l.polos && l.polos.length > 1) ? ' (um dos ' + l.polos.length + ' polos)' : '' %>"></button>
            <% }); }) %>

            </div><!-- /labs-palco -->

            <!-- cartão que aparece quando o grupo não está à vista na lista -->
            <div class="labs-cartao" id="labsCartao" hidden>
              <span class="labs-cartao-logo"></span>
              <span class="labs-cartao-texto">
                <strong class="labs-cartao-sigla"></strong>
                <span class="labs-cartao-local"></span>
              </span>
            </div>

            <!-- as linhas até a lista ou até o cartão são desenhadas aqui -->
            <svg class="labs-linhas" id="labsLinhas" aria-hidden="true"></svg>
          </div>

          <p class="labs-mapa-legenda">
            <span class="labs-legenda-uf"></span> estados com grupos cadastrados —
            clique para filtrar
          </p>
        </div>

        <!-- Lista lateral -->
        <aside class="labs-lista-col" aria-label="Lista de laboratórios">
          <div class="labs-lista-topo">
            <p class="labs-lista-titulo" id="labsFiltroTitulo">Todos os grupos</p>
            <button type="button" class="labs-limpar" id="labsLimpar" hidden>ver todos</button>
          </div>

          <ul class="labs-lista" id="labsLista">
            <% laboratorios.forEach(function (l, i) { %>
            <% var ufsDoGrupo = (l.polos && l.polos.length)
                 ? l.polos.map(function (p) { return p.uf; }).filter(Boolean)
                 : (l.uf ? [l.uf] : []); %>
            <li class="labs-item" data-lab="<%= i %>" data-ufs="<%= ufsDoGrupo.join(',') %>">
              <button type="button" class="labs-item-btn">
                <span class="labs-item-logo <%= l.logo ? '' : 'labs-item-logo--vazia' %>">
                  <% if (l.logo) { %>
                    <img src="<%= l.logo %>" alt="" loading="lazy">
                  <% } else { %>
                    <span><%= l.sigla %></span>
                  <% } %>
                </span>
                <span class="labs-item-texto">
                  <span class="labs-item-sigla"><%= l.sigla %></span>
                  <span class="labs-item-local">
                    <% if (l.polos && l.polos.length > 1) { %>
                      <%= l.polos.map(function (p) { return p.cidade; }).join(' · ') %>
                      <span class="labs-item-polos"><%= l.polos.length %> polos</span>
                    <% } else { %>
                      <%= l.cidade ? l.cidade + '/' + l.uf : 'sem cidade cadastrada' %>
                    <% } %>
                  </span>
                  <span class="labs-item-meta">
                    <%= l.instituicao || '' %><% if (l.integrantes) { %> · <%= l.integrantes %> integrantes<% } %>
                  </span>
                </span>
              </button>
            </li>
            <% }) %>
          </ul>
          <p class="labs-lista-vazia" id="labsListaVazia" hidden>Nenhum grupo neste estado.</p>
        </aside>
      </div>

      <!-- Detalhe do grupo -->
      <div class="labs-popup" id="labsPopup" role="dialog" aria-modal="false" aria-labelledby="labsPopupTitulo" hidden>
        <button type="button" class="labs-popup-fechar" id="labsPopupFechar" aria-label="Fechar">&times;</button>
        <div class="labs-popup-topo">
          <div class="labs-popup-logo" id="labsPopupLogo"></div>
          <div>
            <p class="labs-popup-sigla" id="labsPopupTitulo"></p>
            <p class="labs-popup-nome" id="labsPopupNome"></p>
          </div>
        </div>
        <dl class="labs-popup-dados">
          <div><dt>Instituição</dt><dd id="labsPopupInst"></dd></div>
          <div><dt id="labsPopupCidadeRotulo">Cidade</dt><dd id="labsPopupCidade"></dd></div>
          <div id="labsPopupRespLinha"><dt>Responsável</dt><dd id="labsPopupResp"></dd></div>
          <div id="labsPopupIntegrantesLinha"><dt>Integrantes</dt><dd id="labsPopupIntegrantes"></dd></div>
        </dl>
        <div class="labs-popup-links" id="labsPopupLinks"></div>
      </div>

      <!-- Chamada para novos cadastros -->
      <div class="labs-cadastro">
        <div>
          <h2>Seu grupo ainda não está no mapa?</h2>
          <p>
            A rede é aberta a laboratórios e grupos de pesquisa em Eletrônica de Potência
            de todo o país. Envie os dados do seu grupo e ele entra no mapa na próxima
            atualização, feita mensalmente.
          </p>
        </div>
        <a href="/laboratorios/cadastro" class="btn btn-primary">Cadastrar meu grupo</a>
      </div>

      <% if (semLocal.length) { %>
      <div class="labs-sem-local">
        <h2>Sem localização informada</h2>
        <p>Estes grupos ainda não têm cidade cadastrada e por isso não aparecem no mapa.</p>
        <ul>
          <% semLocal.forEach(function (l) { %>
          <li>
            <strong><%= l.sigla %></strong>
            <% if (l.nome && l.nome !== l.sigla) { %>— <%= l.nome %><% } %>
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </div>
  </section>
</main>

<script id="labsDados" type="application/json"><%- JSON.stringify(laboratorios) %></script>
<script id="labsUfs" type="application/json"><%- JSON.stringify(ufsComLab) %></script>
<script src="/js/laboratorios.js" defer></script>

<%- include('partials/footer') %>
</body>
</html>
