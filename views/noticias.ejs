<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('partials/head', { title: 'Notícias' }) %>
</head>
<body>
<%- include('partials/header') %>

<main id="conteudo">
  <section class="page-hero">
    <div class="container">
      <h1>Notícias</h1>
      <p>Acompanhe as novidades da SOBRAEP.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <% // a paginação precisa carregar o termo buscado junto
         const urlPagina = (p) => `/noticias?${q ? 'q=' + encodeURIComponent(q) + '&' : ''}page=${p}`; %>

      <form action="/noticias" method="get" class="news-busca" role="search">
        <label for="buscaNoticias" class="sr-only">Buscar notícias</label>
        <input type="search" id="buscaNoticias" name="q" value="<%= q %>"
               placeholder="Buscar por título, autor ou assunto…">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <% if (q) { %><a href="/noticias" class="news-busca-limpar">limpar busca</a><% } %>
      </form>

      <% if (q) { %>
        <p class="news-busca-resultado">
          <% if (totalEncontradas) { %>
            <strong><%= totalEncontradas %></strong> notícia<%= totalEncontradas > 1 ? 's' : '' %>
            encontrada<%= totalEncontradas > 1 ? 's' : '' %> para “<%= q %>”.
          <% } else { %>
            Nenhuma notícia encontrada para “<%= q %>”.
          <% } %>
        </p>
      <% } %>

      <% if (!noticias.length) { %>
        <p class="news-vazio">
          <% if (q) { %>
            Tente outras palavras ou <a href="/noticias">veja todas as <%= totalGeral %> notícias</a>.
          <% } else { %>
            Nenhuma notícia encontrada.
          <% } %>
        </p>
      <% } else { %>
      <div class="news-grid">
        <% noticias.forEach(function(n) { %>
        <article class="news-card">
          <a href="/noticias/<%= n.slug %>" class="news-card-media <%= n.imagem ? '' : 'news-card-media--placeholder' %>" aria-label="Ler: <%= n.titulo %>">
            <% if (n.imagem) { %>
              <img src="<%= n.imagem %>" alt="" loading="lazy">
            <% } else { %>
              <span class="news-placeholder-brand" aria-hidden="true">SOBRAEP</span>
              <span class="news-placeholder-label" aria-hidden="true">Em pauta</span>
            <% } %>
          </a>
          <div class="news-card-body">
            <span class="news-date"><%= n.dataFormatada %></span>
            <h3 class="news-title"><a href="/noticias/<%= n.slug %>"><%= n.titulo %></a></h3>
            <p class="news-excerpt"><%= n.resumo %></p>
            <a href="/noticias/<%= n.slug %>" class="news-readmore">Leia mais →</a>
          </div>
        </article>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
      <nav class="pagination" aria-label="Paginação de notícias">
        <a href="<%= urlPagina(page - 1) %>" class="<%= page <= 1 ? 'is-disabled' : '' %>">‹</a>
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a href="<%= urlPagina(p) %>" class="<%= p === page ? 'is-active' : '' %>"><%= p %></a>
        <% } %>
        <a href="<%= urlPagina(page + 1) %>" class="<%= page >= totalPages ? 'is-disabled' : '' %>">›</a>
      </nav>
      <% } %>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
