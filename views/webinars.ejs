<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('partials/head', { title: 'Webinars' }) %>
</head>
<body>
<%- include('partials/header') %>

<main id="conteudo">
  <section class="page-hero">
    <div class="container">
      <h1>Webinars</h1>
      <p>Webinars promovidos pela SOBRAEP e em parceria com a PELS.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <% (webinars || []).forEach(function(w) { %>
        <div class="webinar-card">
          <img src="<%= w.imagem %>" alt="Webinar SOBRAEP" style="border-radius:8px;">
          <div class="webinar-actions">
            <% if (w.linkInscricao) { %>
            <a href="<%= w.linkInscricao %>" target="_blank" rel="noopener" class="btn btn-primary">Registre-se aqui</a>
            <% } else if (w.slides) { %>
            <a href="<%= w.slides %>" target="_blank" rel="noopener" class="btn btn-outline-primary">Slides da apresentação</a>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>

      <p style="margin-top:32px; text-align:center;">
        Confira as gravações no nosso <a href="<%= site.youtube %>" target="_blank" rel="noopener">canal do YouTube</a>.
      </p>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
